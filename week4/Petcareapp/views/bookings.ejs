<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Bookings</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include ('partials/navbar') %>

  <div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="mb-0">My Bookings</h2>
      <a href="/services" class="btn btn-primary">Book a Service</a>
    </div>

    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger">
        <% for (let i = 0; i < errors.length; i++) { %>
          <div><%= errors[i] %></div>
        <% } %>
      </div>
    <% } %>

    <% if (messages && messages.length > 0) { %>
      <div class="alert alert-success">
        <% for (let i = 0; i < messages.length; i++) { %>
          <div><%= messages[i] %></div>
        <% } %>
      </div>
    <% } %>

    <% if (!bookings || bookings.length === 0) { %>
      <div class="alert alert-info">No service bookings found.</div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
          <thead class="table-dark">
            <tr>
              <th>Booking ID</th>
              <th>Pet</th>
              <th>Service</th>
              <th>Booked Price</th>
              <th>Date</th>
              <th>Booking Status</th>
              <th>Payment Status</th>
            </tr>
          </thead>
          <tbody>
            <% for (let i = 0; i < bookings.length; i++) { %>
              <tr>
                <td><%= bookings[i].booking_id %></td>
                <td><%= bookings[i].pet_name || 'Pet' %></td>
                <td><%= bookings[i].service_name || 'Service' %></td>
                <td>S$<%= Number(bookings[i].booked_price).toFixed(2) %></td>
                <td><%= bookings[i].booking_date %></td>
                <td><span class="badge bg-secondary"><%= bookings[i].booking_status %></span></td>
                <td>
                  <% if (bookings[i].payment_status) { %>
                    <span class="badge bg-info text-dark"><%= bookings[i].payment_status %></span>
                  <% } else { %>
                    No payment record
                  <% } %>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
