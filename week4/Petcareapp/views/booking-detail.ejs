<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Booking Details</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include ('partials/navbar') %>

  <div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Booking Details</h2>
      <a href="/bookings" class="btn btn-secondary">Back to Bookings</a>
    </div>

    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger">
        <% for (let i = 0; i < errors.length; i++) { %>
          <div><%= errors[i] %></div>
        <% } %>
      </div>
    <% } %>

    <% if (messages && messages.length > 0) { %>
      <div class="alert alert-success">
        <% for (let i = 0; i < messages.length; i++) { %>
          <div><%= messages[i] %></div>
        <% } %>
      </div>
    <% } %>

    <% if (booking) { %>
      <div class="card shadow-sm">
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-3">Booking ID</dt>
            <dd class="col-sm-9"><%= booking.booking_id %></dd>

            <dt class="col-sm-3">Pet</dt>
            <dd class="col-sm-9"><%= booking.pet_name %></dd>

            <dt class="col-sm-3">Service</dt>
            <dd class="col-sm-9"><%= booking.service_name %></dd>

            <dt class="col-sm-3">Booked Price</dt>
            <dd class="col-sm-9">S$<%= Number(booking.booked_price).toFixed(2) %></dd>

            <dt class="col-sm-3">Booking Date</dt>
            <dd class="col-sm-9"><%= booking.booking_date %></dd>

            <dt class="col-sm-3">Booking Status</dt>
            <dd class="col-sm-9"><span class="badge bg-secondary"><%= booking.booking_status %></span></dd>

            <dt class="col-sm-3">Payment Status</dt>
            <dd class="col-sm-9">
              <% if (booking.payment_status) { %>
                <span class="badge bg-info text-dark"><%= booking.payment_status %></span>
              <% } else { %>
                No payment record
              <% } %>
            </dd>
          </dl>
        </div>
      </div>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
