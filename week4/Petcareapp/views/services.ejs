<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Pet Services</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include ('partials/navbar') %>

  <div class="container mt-5">
    <h2 class="mb-4">Book a Service</h2>

    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger">
        <% for (let i = 0; i < errors.length; i++) { %>
          <div><%= errors[i] %></div>
        <% } %>
      </div>
    <% } %>

    <% if (messages && messages.length > 0) { %>
      <div class="alert alert-success">
        <% for (let i = 0; i < messages.length; i++) { %>
          <div><%= messages[i] %></div>
        <% } %>
      </div>
    <% } %>

    <% if (pets && pets.length > 0) { %>
      <form action="/services/book" method="POST" class="card shadow-sm mb-4">
        <div class="card-body">
          <div class="row g-3 align-items-end">
            <div class="col-md-4">
              <label for="petId" class="form-label">Pet</label>
              <select name="petId" id="petId" class="form-select" required>
                <% for (let i = 0; i < pets.length; i++) { %>
                  <option value="<%= pets[i].id %>" <%= selectedPetId && Number(selectedPetId) === Number(pets[i].id) ? 'selected' : '' %>>
                    <%= pets[i].name %>
                  </option>
                <% } %>
              </select>
            </div>

            <div class="col-md-4">
              <label for="bookingDate" class="form-label">Booking date</label>
              <input type="date" name="bookingDate" id="bookingDate" class="form-control" min="<%= today %>" required>
            </div>

            <div class="col-md-4">
              <label class="form-label">Create booking</label>
              <button type="submit" class="btn btn-primary w-100">Create Booking</button>
            </div>
          </div>
        </div>
      </form>
    <% } else { %>
      <div class="alert alert-warning">Add a pet first before booking a service.</div>
      <a href="/pets/new" class="btn btn-primary">Add Pet</a>
    <% } %>

    <div class="row g-4">
      <% if (services && services.length > 0) { %>
        <% for (let i = 0; i < services.length; i++) { %>
          <div class="col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm border-0">
              <div class="card-body d-flex flex-column">
                <h5 class="card-title"><%= services[i].name %></h5>
                <p class="text-muted mb-3">Price: S$<%= Number(services[i].price).toFixed(2) %></p>

                <% if (pets && pets.length > 0) { %>
                  <form action="/services/book" method="POST" class="mt-auto">
                    <input type="hidden" name="petId" value="<%= selectedPetId || pets[0].id %>">
                    <input type="hidden" name="serviceId" value="<%= services[i].id %>">
                    <div class="mb-2">
                      <label class="form-label small text-muted">Choose date</label>
                      <input type="date" name="bookingDate" class="form-control" min="<%= today %>" required>
                    </div>
                    <button type="submit" class="btn btn-success w-100">Book this service</button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        <% } %>
      <% } else { %>
        <div class="col-12">
          <div class="alert alert-info">No active services available right now.</div>
        </div>
      <% } %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
